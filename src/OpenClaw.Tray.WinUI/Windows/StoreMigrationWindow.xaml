<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OpenClawTray.Windows.StoreMigrationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Padding="28" RowSpacing="20"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="Heading" Style="{StaticResource TitleTextBlockStyle}"
                   TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <ProgressRing x:Name="Progress" Width="32" Height="32" HorizontalAlignment="Left"/>
                <TextBlock x:Name="Status" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                           AutomationProperties.AutomationId="MigrationStatus"
                           AutomationProperties.LiveSetting="Polite"/>
                <InfoBar x:Name="Error" IsOpen="False" Severity="Error" IsClosable="True"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Spacing="10">
            <Button x:Name="InstalledApps" Click="OnInstalledApps"
                    HorizontalAlignment="Stretch" AutomationProperties.AutomationId="MigrationInstalledApps"/>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="Primary" Click="OnPrimary" HorizontalAlignment="Stretch"
                        Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.AutomationId="MigrationPrimary"/>
                <Button x:Name="Dismiss" Grid.Column="1" Click="OnDismiss" HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="MigrationDismiss"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
